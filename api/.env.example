# SubscribAI API (NestJS) environment variables
# Copy to api/.env for local dev. In production, set these in the Render dashboard.

# ---- Server ----
PORT=4000
# Comma-separated list of allowed frontend origins (your Vercel domain + local dev).
FRONTEND_ORIGIN=http://localhost:3001
SITE_URL=http://localhost:3001
# Public URL the backend itself is reachable at — PayFast calls SUCCESS_URL /
# FAILURE_URL / CHECKOUT_URL on this host. For local dev behind a tunnel
# (ngrok/cloudflared) set this to the public tunnel URL.
PAYFAST_PUBLIC_API_URL=http://localhost:4000

# ---- Supabase ----
# Note: NOT prefixed with NEXT_PUBLIC_ here — this is a standalone Node service.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- PayFast (apps.net.pk) ----
# Hosts are merchant-specific — PayFast support tells you yours. Common ones:
#   Live (per-merchant numbered):  https://ipg1.apps.net.pk  (or ipg2, ipg3 …)
#   UAT / sandbox:                 https://ipguat.apps.net.pk
PAYFAST_BASE_URL=https://ipg1.apps.net.pk
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_NAME=SubscribAI
PAYFAST_SECURED_KEY=
# Default CURRENCY_CODE if the frontend doesn't override it per request.
# The checkout page typically sends PKR for PK visitors and USD for foreigners.
PAYFAST_CURRENCY=PKR

# ---- Cloudinary (uploads) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=subscribai_admin

# ---- SMTP / email (notifications) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Auth (JWT) ----
# Used to sign access tokens issued by POST /auth/login. Generate a fresh one
# per environment: `openssl rand -hex 32`. Leaking it lets attackers forge tokens.
JWT_SECRET=
JWT_ACCESS_TTL=7d

# ---- Cron ----
CRON_SECRET=

# ---- WhatsApp (subscription delivery automation) ----
# Provider: cloud | custom | manual.
#   cloud  → WhatsApp Cloud API (Meta Graph). Needs the two vars below.
#   custom → any third-party gateway that accepts a JSON POST.
#   manual → no API; the admin panel renders each message and hands the admin
#            a one-click wa.me link. This is the default when nothing is set.
# Leave WHATSAPP_PROVIDER empty to auto-detect from the credentials present.
WHATSAPP_PROVIDER=
# Business number shown in the admin panel ("sending from ..."). Display only.
WHATSAPP_BUSINESS_NUMBER=

# -- cloud provider (Meta) --
# Phone number ID + permanent access token from the Meta app dashboard.
# NOTE: free-form text only reaches a customer inside the 24-hour customer
# service window; outside it Meta requires a pre-approved message template.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_GRAPH_URL=https://graph.facebook.com

# -- custom gateway --
# Endpoint receives {"<to field>": "+92300...", "<body field>": "message"}
# plus anything in WHATSAPP_CUSTOM_EXTRA (a JSON object).
WHATSAPP_CUSTOM_URL=
WHATSAPP_CUSTOM_TOKEN=
WHATSAPP_CUSTOM_TOKEN_HEADER=Authorization
WHATSAPP_CUSTOM_TO_FIELD=to
WHATSAPP_CUSTOM_BODY_FIELD=message
WHATSAPP_CUSTOM_EXTRA=

# ---- Delivery automation behaviour ----
# Refuse an identical message to the same number inside this window (0 = off).
DELIVERY_DUPLICATE_WINDOW_MINUTES=10
# Renewal reminders go out this many days before subscription_sales.renew_date.
DELIVERY_REMINDER_DAYS_BEFORE=3
# Language used by the automatic reminder / expiry messages.
DELIVERY_DEFAULT_LANGUAGE=en
# Set to false to stop the daily renewal + expiry sweep.
DELIVERY_REMINDERS_ENABLED=true

# ---- Internal server-to-server token ----
# Shared secret the Next.js admin Server Actions send as `x-internal-token`
# when calling /emails/* and /delivery/*. Must match INTERNAL_API_TOKEN in the
# frontend env. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=
