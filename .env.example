# SubscribAI FRONTEND environment variables (Next.js on Vercel)
# Copy to .env.local and fill in real values.
#
# NOTE: Server-only secrets (PayFast, Supabase service role, Cloudinary,
# SMTP, CRON_SECRET) now live in the BACKEND — see api/.env.example. The
# frontend only needs the public values below plus the API base URL.

# ---- Site ----
SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---- Backend API (NestJS on Render) ----
# Base URL of the standalone backend. Local dev: http://localhost:4000
# Production: your Render service URL, e.g. https://subscribai-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Supabase (Project → Settings → API) ----
# Only the anon key here — it is safe to ship to the browser. The service-role
# key is backend-only (api/.env). Used by the browser client (auth) and by
# Next server reads / admin Server Actions (via RLS).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Cloudinary (public cloud name only, if referenced in the UI) ----
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# ---- Internal server-to-server token ----
# Sent as `x-internal-token` when the admin Server Actions call the backend
# (promotional emails, subscription delivery automation). Must match
# INTERNAL_API_TOKEN in api/.env. Without it those calls are rejected unless
# the backend also has no token set. Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=


