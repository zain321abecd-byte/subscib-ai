# SubscribAI environment variables
# Copy to .env.local and fill in real values.

# ---- SahulatPay (payment gateway) ----
SAHULATPAY_BASE_URL=https://api.assanpay.com
SAHULATPAY_MERCHANT_ID=
SAHULATPAY_API_KEY=
SAHULATPAY_MASTER_SECRET_KEY=
SAHULATPAY_WALLET_MODE=direct
SAHULATPAY_JAZZCASH_MODE=async
SAHULATPAY_EASYPAISA_MODE=direct

# ---- Site ----
SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ---- Supabase (Project → Settings → API) ----
# anon key is safe to ship to the browser; service role is server-only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# ---- Stock expiry reminder email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ---- Cloudinary (Dashboard → Settings → Access Keys) ----
# CLOUDINARY_UPLOAD_PRESET should be an unsigned preset; we sign it server-side.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=subscribai_admin
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
