# The NestJS backend deploys to Render, not Vercel. Keep it out of the
# frontend build/upload entirely.
api
!app/api
!app/api/**

# panel/ is the superseded standalone build of the SMM panel. The panel now
# lives in this app under app/panel/ — this entry just makes sure a leftover
# local copy of the old one can never be picked up by a deploy.
panel
