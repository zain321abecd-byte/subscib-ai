# The NestJS backend deploys to Render, not Vercel. Keep it out of the
# frontend build/upload entirely.
api
!app/api
!app/api/**

# panel/ is the superseded standalone build of the SMM panel; the panel itself
# now lives in this app under app/panel/.
#
# The leading slash is essential. .vercelignore follows .gitignore matching, so
# a bare `panel` matches a segment at ANY depth — it silently excluded
# app/panel/ from the deployment, and every panel route 404'd in production
# while building fine locally. Anchor it to the repo root.
/panel
